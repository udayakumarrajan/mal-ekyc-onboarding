{
  "name": "ekyc-onboarding",
  "version": "1.0.0",
  "description": "A fullstack eKYC onboarding platform with React Native mobile app and Node.js backend API",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "cd apps/api && npm run dev",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "dev": "npm-run-all --parallel dev:api dev:mobile",
    "test": "npm-run-all test:api test:mobile",
    "test:api": "cd apps/api && npm test",
    "test:mobile": "cd apps/mobile && npm test",
    "build:api": "cd apps/api && npm run build",
    "build:mobile": "cd apps/mobile && npm run build",
    "lint": "npm-run-all lint:api lint:mobile",
    "lint:api": "cd apps/api && npm run lint",
    "lint:mobile": "cd apps/mobile && npm run lint",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.expo apps/*/dist apps/*/build",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "keywords": [
    "ekyc",
    "onboarding",
    "react-native",
    "expo",
    "nodejs",
    "express",
    "typescript",
    "fullstack",
    "authentication",
    "verification"
  ],
  "author": "Fullstack Engineer",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ekyc-onboarding.git"
  },
  "dependencies": {
    "expo": "~50.0.17",
    "react": "18.2.0",
    "react-native": "0.73.6"
  }
}
